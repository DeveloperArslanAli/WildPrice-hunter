PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://wildprice:wildprice_secret@localhost:5432/wildprice

# Redis
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# JWT
JWT_SECRET=change_me_in_production_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Firecrawl Scraping & Extraction Engine (Primary)
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here
FIRECRAWL_API_URL=https://api.firecrawl.dev

# Legacy Scraping Providers (Deprecated)
# SERPAPI_KEY=your_serpapi_key_here
# RAINFOREST_API_KEY=your_rainforest_key_here

# Optional: DataForSEO (price intelligence)
DATAFORSEO_LOGIN=your_login
DATAFORSEO_PASSWORD=your_password

# Firebase (push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Proxy (optional - rotating residential)
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=30

# Free tier search limit per day
FREE_TIER_DAILY_SEARCHES=5
